{
  "name": "tivity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tivity — AI-native Project Operating System (pnpm monorepo)",
  "scripts": {
    "dev": "pnpm --filter @tivity/desktop dev",
    "build": "pnpm --filter @tivity/desktop build",
    "preview": "pnpm --filter @tivity/desktop preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @tivity/core --filter @tivity/github-sync --filter @tivity/agent-runtime --filter @tivity/ide-client --filter ./apps/vscode-tivity test",
    "tauri": "pnpm --filter @tivity/desktop tauri",
    "tauri:dev": "pnpm --filter @tivity/desktop tauri:dev",
    "tauri:build": "pnpm --filter @tivity/desktop tauri:build"
  }
}
