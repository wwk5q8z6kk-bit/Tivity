{
  "name": "@tivity/ide-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tivity IDE client: node:sqlite store opener, shared ops, MCP stdio server",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "tivity-mcp": "./dist/tivity-mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/launch.ts --bundle --platform=node --format=esm --outfile=dist/tivity-mcp.mjs --banner:js=\"#!/usr/bin/env node\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@tivity/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "typescript": "~5.8",
    "vitest": "^3"
  }
}
